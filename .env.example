PROJECT_NAME="RAG UUD Decision Support"

# Database PostgreSQL (Laragon Default)
PGHOST=localhost
PGPORT=5432
PGDATABASE=aitta_db
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=disable
DATABASE_URL=postgresql://postgres@localhost:5432/aitta_db

# Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# OpenRouter LLM (Free Models: https://openrouter.ai/models?q=:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
CLEANING_LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
CLEANING_LLM_TEMPERATURE=0.1
CLEANING_LLM_CONCURRENCY=2

# Chunking token limits
# CHUNK_MIN_TOKENS harus rendah (5-10) karena BAB hanya 4-5 token
CHUNK_LEVEL_1_MAX_TOKENS=1500
CHUNK_LEVEL_2_MAX_TOKENS=800
CHUNK_LEVEL_3_MAX_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
CHUNK_MIN_TOKENS=5